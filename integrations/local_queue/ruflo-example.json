{
  "id": "storyboard-example",
  "adapter": "ruflo",
  "request": {
    "publication_enabled": false,
    "endpoint": "http://127.0.0.1:11434",
    "model": "local-model",
    "workers": 1,
    "max_tokens": 80,
    "timeout_seconds": 5,
