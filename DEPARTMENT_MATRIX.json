{
  "version": "12.0.0",
  "departments": [
    {
      "id": "research",
      "mission": "Prove current demand and claims with fresh independent evidence",
      "capabilities": [
        "source freshness",
        "evidence quality/conflicts",
        "trend scoring",
        "competitor gaps"
      ],
      "external": [
        "live marketplace/search/social sources"
      ]
    },
    {
      "id": "reverse_engineering",
      "mission": "Find proven winners, preserve what works, remove negatives, create a differentiated better path",
      "capabilities": [
        "complaint mining",
        "improvement specs",
        "supplier scoring",
        "IP guardrails"
      ],
      "external": [
        "live reviews/forums/supplier quotes"
      ]
    },
    {
      "id": "finance",
      "mission": "Protect contribution margin, cash, and downside",
      "capabilities": [
        "unit economics",
        "break-even",
        "cash runway",
        "budget guard"
      ],
      "external": [
        "real payment/cost/tax data"
      ]
    },
    {
      "id": "acquisition",
      "mission": "Acquire qualified demand without cold email and diagnose the bottleneck closest to money",
      "capabilities": [
        "channel scoring",
        "funnel diagnosis",
        "controlled experiments",
        "attribution"
      ],
      "external": [
        "social/marketplace/ad analytics"
      ]
    },
    {
      "id": "content",
      "mission": "Produce phase-compliant creative without unsupported claims",
      "capabilities": [
        "RESEARCH/PRELAUNCH/LAUNCH rules",
        "product-demo skill",
        "claim/CTA restrictions"
      ],
      "external": [
        "publishing accounts"
      ]
    },
    {
