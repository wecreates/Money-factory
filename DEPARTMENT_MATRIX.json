      "external": [
        "CRM/order/subscription events"
      ]
    },
    {
      "id": "fulfillment",
      "mission": "Deliver paid value reliably and prove completion",
      "capabilities": [
        "order state machine",
        "SLA health",
        "overdue/lost/refund detection"
      ],
      "external": [
        "supplier/carrier/digital delivery"
      ]
    },
    {
      "id": "support",
      "mission": "Auto-resolve routine issues and escalate money/safety/legal risk",
      "capabilities": [
        "support health",
        "critical backlog",
        "auto-resolvable queue"
      ],
      "external": [
        "customer support channels"
      ]
    },
    {
      "id": "security",
      "mission": "Keep consequential actions approved, scoped, traceable and fail-closed",
      "capabilities": [
        "risk register",
        "critical/high prioritization",
        "approval gates"
      ],
      "external": [
        "credentials/permissions/legal review"
      ]
    },
    {
      "id": "operations",
      "mission": "Keep workers/providers healthy and reconcile ambiguity",
      "capabilities": [
        "department health board",
        "persistent audit snapshots",
        "worker/provider monitoring"
      ],
      "external": [
        "provider uptime"
      ]
    },
    {
      "id": "portfolio",
      "mission": "Allocate effort/capital to verified winners and kill failed lanes",
      "capabilities": [
        "verified-profit ranking",
        "SCALE/TEST/OPTIMIZE/HOLD/KILL"
      ],
      "external": [
        "verified revenue/cost outcomes"
      ]
