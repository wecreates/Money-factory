{
  "version": 1,
  "updated_at": "2026-10-05",
  "modes": {
    "RESEARCH": {
      "purpose": "Validate demand, pains, competitors, product mechanics, and audience response.",
      "allowed": [
        "educational content",
        "trend analysis",
        "problem content",
        "build-in-public research",
        "comparison content with sourced claims"
      ],
      "forbidden": [
        "buy-now claims",
        "shipping promises",
        "unverified performance claims",
        "fake testimonials"
      ]
    },
    "PRELAUNCH": {
      "purpose": "Build demand and test positioning before the full offer is released.",
      "allowed": [
        "teasers",
        "waitlist content",
        "product demos with verified functionality",
        "explainer content",
        "founder/build-in-public",
        "lead magnets",
        "offer testing",
        "pricing perception tests"
      ],
      "forbidden": [
        "claiming availability when not available",
        "unverified delivery dates",
        "unverified guarantees",
        "fabricated social proof"
      ]
    },
    "LAUNCH": {
      "purpose": "Direct-response content for an offer that passed validation and provider gates.",
      "allowed": [
        "buy-now CTA",
        "verified pricing",
        "verified fulfillment claims",
        "verified demos",
        "verified proof",
        "retargeting creatives",
        "customer onboarding content"
      ],
      "forbidden": [
        "claims beyond verified evidence",
        "unsupported scarcity",
        "misleading luxury/status signals"
      ]
    }
  },
  "global_claim_gates": {
    "product_facts": "must be verified before factual product-specific claims",
    "price": "must be current and verified before direct-response creative",
    "shipping": "must be verified per supplier/provider before promise",
    "safety": "must be supported by actual documentation/certifications",
    "warranty_returns": "must match real provider terms",
    "revenue_results": "must come from verified revenue events",
    "social_proof": "must be authentic and attributable",
    "publication": "remains false unless the business has explicit release approval and required providers are healthy"
  },
